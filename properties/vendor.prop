# Bluetooth
bluetooth.device.default_name=OnePlus 15

# Display
vendor.display.enable_spr_bypass=0
vendor.display.enable_spr=1

# Graphics
ro.surface_flinger.set_idle_timer_ms=500
ro.surface_flinger.set_touch_timer_ms=1000

# USB
vendor.usb.product_string=OnePlus 15

# VibratorExt
ro.vendor.vibrator.device=infiniti
